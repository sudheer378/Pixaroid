{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"SAMEORIGIN"}]},{"source":"/(.*\\.xml)$","headers":[{"key":"Content-Type","value":"application/xml; charset=utf-8"},{"key":"Cache-Control","value":"public, max-age=3600, must-revalidate"}]},{"source":"/robots.txt","headers":[{"key":"Content-Type","value":"text/plain; charset=utf-8"},{"key":"Cache-Control","value":"public, max-age=3600"}]},{"source":"/workers/(.*)\\.js$","headers":[{"key":"Content-Type","value":"application/javascript; charset=utf-8"},{"key":"Cross-Origin-Opener-Policy","value":"same-origin"},{"key":"Cross-Origin-Embedder-Policy","value":"require-corp"}]},{"source":"/sw.js","headers":[{"key":"Content-Type","value":"application/javascript; charset=utf-8"},{"key":"Cache-Control","value":"no-cache, no-store, must-revalidate"},{"key":"Service-Worker-Allowed","value":"/"}]},{"source":"/(css|js|assets|images|fonts)/(.*)","headers":[{"key":"Cache-Control","value":"public, max-age=31536000, immutable"}]},{"source":"/(.*\\.html?)$","headers":[{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]}],
  "rewrites": [{"source":"/compress","destination":"/tools/compression/index.html"},{"source":"/convert","destination":"/tools/conversion/index.html"},{"source":"/resize","destination":"/tools/resize/index.html"},{"source":"/editor","destination":"/tools/editor/index.html"},{"source":"/ai","destination":"/tools/ai-tools/index.html"},{"source":"/social","destination":"/tools/social-tools/index.html"},{"source":"/pdf","destination":"/tools/pdf-tools/index.html"},{"source":"/utilities","destination":"/tools/utilities/index.html"},{"source":"/guides","destination":"/guides/index.html"},{"source":"/tools/international/currency-converter/","destination":"/tools/international/currency-converter.html"},{"source":"/tools/international/timezone-planner/","destination":"/tools/international/timezone-planner.html"},{"source":"/tools/international/text-translator/","destination":"/tools/international/text-translator.html"},{"source":"/tools/international/phone-code-finder/","destination":"/tools/international/phone-code-finder.html"},{"source":"/tools/international/unit-converter/","destination":"/tools/international/unit-converter.html"},{"source":"/tools/international/holiday-calendar/","destination":"/tools/international/holiday-calendar.html"},{"source":"/tools/international/passport-photo-resizer/","destination":"/tools/international/passport-photo-resizer.html"},{"source":"/tools/international/vat-calculator/","destination":"/tools/international/vat-calculator.html"},{"source":"/tools/international/paper-size-converter/","destination":"/tools/international/paper-size-converter.html"},{"source":"/tools/international/script-detector/","destination":"/tools/international/script-detector.html"},{"source":"/tools/international/address-formatter/","destination":"/tools/international/address-formatter.html"},{"source":"/tools/international/packing-list-generator/","destination":"/tools/international/packing-list-generator.html"}]
}