```
# Web workers
tools/pdf-tools/workers/*.worker.js
workers/*.worker.js

# PDF tools related build artifacts
tools/pdf-tools/js/pdf/*.js

# Temporary HTML files that might be generated during builds
*.html.tmp
*.html.bak

# Local environment files that might be created
.env.local
.env

# Editor and IDE files
.vscode/
.idea/
*.swp
*.swo

# Log files
*.log

# Backup and temporary files
*.tmp
*.bak
*.backup
```