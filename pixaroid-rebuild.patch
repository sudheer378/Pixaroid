++  font-weight: 700;
++  color: #00d4ff;
++  letter-spacing: -0.02em;
++}
++
++.nav-menu {
++  list-style: none;
++  display: flex;
++  align-items: center;
++  gap: 20px;
++}
++
++.nav-menu li a {
++  color: #c6c6dd;
++  font-size: 0.95rem;
++  transition: color 0.2s;
++}
++
++.nav-menu li a:hover {
++  color: #00d4ff;
++}
++
