++.site-footer p {
++  color: #8a8aa8;
++  font-size: 0.9rem;
++  margin-bottom: 10px;
++}
++
++.footer-links {
++  display: flex;
++  gap: 20px;
++  flex-wrap: wrap;
++}
++
++.footer-links a {
++  color: #8a8aa8;
++  font-size: 0.9rem;
++  transition: color 0.2s;
++}
++
++.footer-links a:hover {
++  color: #00d4ff;
++}
