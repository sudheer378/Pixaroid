+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8"/>
+<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
+<meta name="description" content="Free online age calculator. Find your exact age in years, months and days, your total days lived, and a countdown to your next birthday. No upload."/>
+<meta name="keywords" content="age calculator, calculate my age, date of birth calculator, how old am i"/>
+<meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large"/>
+<link rel="canonical" href="https://pixaroid.vercel.app/tools/utilities/age-calculator/"/>
+<meta property="og:type" content="website"/>
+<meta property="og:site_name" content="Pixaroid — Free Image & PDF Tools"/>
+<meta property="og:title" content="Age Calculator Online Free — Calculate Your Exact Age | Pixaroid"/>
+<meta property="og:description" content="Free online age calculator. Find your exact age in years, months and days, your total days lived, and a countdown to your next birthday. No upload."/>
+<meta property="og:url" content="https://pixaroid.vercel.app/tools/utilities/age-calculator/"/>
+<meta property="og:image" content="https://pixaroid.vercel.app/assets/images/og-default.png"/>
+<meta property="og:image:width" content="1200"/>
+<meta property="og:image:height" content="630"/>
+<meta name="twitter:card" content="summary_large_image"/>
+
+<title>Age Calculator Online Free — Calculate Your Exact Age | Pixaroid</title>
+<link rel="icon" href="/assets/svg/favicon.svg" type="image/svg+xml"/>
+<link rel="preconnect" href="https://fonts.googleapis.com"/>
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
+<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet"/>
+
+<style>
+:root{--bg:#070711;--s1:#0E0E1C;--s2:#15152A;--s3:#1C1C36;--bd:rgba(255,255,255,.06);--bd2:rgba(255,255,255,.11);--tx:#EEEEF8;--mu:#8888AA;--su:#3A3A5C;--ac:#7C6FFF;--ac2:#9D93FF;--gn:#23D67A;--rd:#FF4F4F;--cy:#14D9C4;--fd:'Sora',sans-serif;--fb:'Nunito Sans',sans-serif;}
+*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
+body{font-family:var(--fb);background:var(--bg);color:var(--tx);line-height:1.65;}
+a{color:inherit;text-decoration:none;}h1,h2,h3{font-family:var(--fd);}button{cursor:pointer;font-family:var(--fb);}
+.W{max-width:960px;margin:0 auto;padding:0 1.25rem;}
+nav.topnav{position:sticky;top:0;z-index:200;background:rgba(7,7,17,.82);backdrop-filter:blur(24px);border-bottom:1px solid var(--bd);height:56px;display:flex;align-items:center;}
+.ni{display:flex;align-items:center;gap:1rem;width:100%;max-width:960px;margin:0 auto;padding:0 1.25rem;}
+.logo{font-family:var(--fd);font-weight:800;font-size:1.125rem;color:#fff;}
+.nlink{font-size:.875rem;color:var(--mu);padding:.375rem .5rem;}
+.nlink:hover{color:var(--tx);}
+.hero{padding:2rem 0 1.5rem;border-bottom:1px solid var(--bd);}
+.ht{font-size:clamp(1.5rem,3.5vw,2.25rem);font-weight:800;margin-bottom:.5rem;}
+.hd{font-size:.9375rem;color:var(--mu);max-width:640px;}
+.tc{background:var(--s1);border:1px solid var(--bd2);border-radius:16px;overflow:hidden;margin-top:1.5rem;}
+.tc-in{padding:1.375rem;}
+label.cl{display:block;font-size:.8125rem;font-weight:600;color:var(--mu);margin-bottom:.4rem;}
+label.cl .cv{font-family:var(--fd);font-size:.75rem;color:var(--ac2);font-weight:700;background:rgba(124,111,255,.1);padding:.1rem .4rem;border-radius:4px;float:right;}
+input[type=text],input[type=number],input[type=date],select,textarea{width:100%;padding:.6rem .75rem;border:1px solid var(--bd2);border-radius:8px;background:var(--s2);color:var(--tx);font-family:var(--fb);font-size:.875rem;outline:none;margin-bottom:.9rem;transition:border-color .2s;}
+textarea{resize:vertical;min-height:110px;font-size:.9375rem;line-height:1.7;}
+input:focus,select:focus,textarea:focus{border-color:var(--ac);}
+input[type=color]{width:46px;height:36px;padding:2px;border:1px solid var(--bd2);border-radius:8px;background:var(--s2);}
+input[type=range]{width:100%;-webkit-appearance:none;height:4px;border-radius:999px;background:var(--bd2);margin:.4rem 0 1rem;}
+input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:var(--ac);}
+input[type=file]{width:100%;color:var(--mu);font-size:.8125rem;margin-bottom:.9rem;}
+input[type=checkbox],input[type=radio]{accent-color:var(--ac);margin-right:.4rem;}
+.btnp{display:inline-flex;align-items:center;gap:.5rem;padding:.75rem 1.6rem;border-radius:11px;border:none;font-family:var(--fd);font-weight:700;font-size:.9375rem;background:linear-gradient(135deg,var(--ac),#9C40FF);color:#fff;box-shadow:0 4px 20px rgba(124,111,255,.3);}
+.btnp:hover:not(:disabled){transform:translateY(-2px);}
+.btnp:disabled{opacity:.35;cursor:not-allowed;}
+.btnr{padding:.7rem 1rem;border-radius:11px;border:1px solid var(--bd2);background:transparent;color:var(--mu);font-size:.875rem;}
+.btnr:hover{color:var(--tx);}
+.btns{padding:.42rem .8rem;border-radius:8px;border:1px solid var(--bd2);background:transparent;color:var(--mu);font-size:.75rem;}
+.btns:hover{color:var(--ac2);border-color:var(--ac);}
+.row{display:flex;gap:.75rem;flex-wrap:wrap;align-items:center;}
+.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.75rem;margin-bottom:.9rem;}
+.grid4{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:.75rem;margin-bottom:.9rem;}
+.stat{background:var(--s2);border:1px solid var(--bd);border-radius:10px;padding:.75rem;text-align:center;}
+.stat b{display:block;font-family:var(--fd);font-size:1.25rem;color:var(--ac2);}
+.stat span{font-size:.7rem;color:var(--mu);text-transform:uppercase;letter-spacing:.05em;}
+.out{display:none;margin-top:1rem;}
+.out.V{display:block;}
+canvas.preview{max-width:100%;border:1px solid var(--bd2);border-radius:10px;background:#fff;}
+pre.outp{background:var(--s2);border:1px solid var(--bd2);border-radius:10px;padding:1rem;font-size:.8125rem;overflow:auto;max-height:380px;white-space:pre-wrap;word-break:break-word;color:var(--tx);}
+.err{color:var(--rd);font-size:.8125rem;margin-top:.5rem;display:none;}
+.err.V{display:block;}
+.hint{font-size:.8125rem;color:var(--su);margin-top:.4rem;}
+.ok{color:var(--gn);} .bad{color:var(--rd);}
+.faq{padding:1.75rem 0 1rem;}
+.faq h2{font-weight:700;font-size:1.5rem;margin-bottom:1.1rem;}
+.faq-item{border:1px solid var(--bd);border-radius:12px;margin-bottom:.75rem;overflow:hidden;background:var(--s1);}
+.faq-q{width:100%;padding:1rem 1.25rem;text-align:left;background:transparent;border:none;color:var(--tx);font-family:var(--fd);font-weight:600;font-size:.9375rem;display:flex;align-items:center;justify-content:space-between;cursor:pointer;}
+.faq-a{max-height:0;overflow:hidden;transition:max-height .3s ease;}
+.faq-item.open .faq-a{max-height:400px;}
+.faq-a-inner{padding:0 1.25rem 1rem;color:var(--mu);font-size:.875rem;line-height:1.7;}
+.relh{font-family:var(--fd);font-weight:700;font-size:1.125rem;margin:1.25rem 0 .75rem;}
+.rel{display:flex;flex-wrap:wrap;gap:.5rem;padding-bottom:2rem;}
