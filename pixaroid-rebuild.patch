+/**
+ * Pixaroid PDF Tool Runner — shared UI/runtime for all PDF tool pages.
+ * Driven by `window.PIXAROID_TOOL` config (set inline by each tool page)
+ * and `window.getToolOptions` (optional, per-tool options from controls).
+ */
+(function () {
+  'use strict';
+  var C = window.PIXAROID_TOOL;
+  if (!C || typeof PDFEngine === 'undefined') return;
+  var $ = function (id) { return document.getElementById(id); };
+
+  var dz = $('dz'), fi = $('fi'), sp = $('sp'), ab = $('ab'), pw = $('pw'),
+    pf = $('pf'), pd = $('pd'), pl = $('pl'), bp = $('bp'), br = $('br'),
+    sv = $('sv'), svn = $('svn'), svs = $('svs'), fn = $('fn'),
+    toast = $('toast'), toastMsg = $('toastMsg'),
+    opBox = $('op'), oo = $('oo'), boc = $('boc'), bod = $('bod'),
+    sigWrap = $('sigWrap'), sigInput = $('sigInput'),
